{
  "rules": {
    ".read": false,
    ".write": false,
    "ggfc": {
      "v3": {
        ".read": true,
        ".write": "auth != null && auth.token.email === 'ggfc-admin@example.com' && auth.token.firebase.sign_in_provider === 'password' && newData.exists()",
        ".validate": "newData.hasChild('meta') && newData.child('meta/updatedBy').val() === auth.uid && newData.child('meta/revision').isNumber() && newData.child('meta/revision').val() === (data.child('meta/revision').isNumber() ? data.child('meta/revision').val() + 1 : 1)",
        "meta": {
          ".validate": "newData.hasChildren(['version', 'revision', 'updatedBy', 'savedAt', 'keyEncoding'])",
          "savedAt": {
            ".validate": "newData.isNumber() && newData.val() <= now && newData.val() >= now - 300000"
          },
          "version": {
            ".validate": "newData.isString()"
          },
          "revision": {
            ".validate": "newData.isNumber() && newData.val() >= 1"
          },
          "updatedBy": {
            ".validate": "newData.isString() && newData.val() === auth.uid"
          },
          "keyEncoding": {
            ".validate": "newData.val() === 'base64url-v1'"
          },
          "$other": {
            ".validate": false
          }
        },
        "records": {
          "$kind": {
            ".validate": "$kind === 'matches' || $kind === 'attendance' || $kind === 'goals' || $kind === 'saves' || $kind === 'fouls' || $kind === 'moms' || $kind === 'specials'"
          }
        },
        "players": {
          "$kind": {
            ".validate": "$kind === 'roster' || $kind === 'soccerbee'"
          }
        },
        "settings": {
          ".validate": "newData.hasChildren()"
        },
        "adminLog": {
          ".validate": "newData.hasChildren()"
        },
        "$other": {
          ".validate": false
        }
      },
      "thumbnailAccess": {
        ".read": true,
        ".write": "auth != null && auth.token.email === 'ggfc-admin@example.com' && auth.token.firebase.sign_in_provider === 'password' && newData.exists()",
        ".validate": "newData.hasChildren(['enabled','uid','email','revision','changedAt']) && newData.child('revision').val() === (data.child('revision').isNumber() ? data.child('revision').val()+1 : 1)",
        "enabled": {
          ".validate": "newData.isBoolean()"
        },
        "uid": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 128"
        },
        "email": {
          ".validate": "newData.isString() && newData.val().matches(/^ggfc-thumbnail-[a-f0-9]{32}@example[.]com$/)"
        },
        "revision": {
          ".validate": "newData.isNumber()"
        },
        "changedAt": {
          ".validate": "newData.isNumber() && newData.val() <= now && newData.val() >= now - 300000"
        },
        "$other": {
          ".validate": false
        }
      },
      "thumbnailTemplate": {
        ".read": true,
        ".write": "((auth != null && auth.token.email === 'ggfc-admin@example.com' && auth.token.firebase.sign_in_provider === 'password') || (auth != null && auth.token.firebase.sign_in_provider === 'password' && root.child('ggfc/thumbnailAccess/enabled').val() === true && root.child('ggfc/thumbnailAccess/uid').val() === auth.uid && root.child('ggfc/thumbnailAccess/email').val() === auth.token.email)) && newData.exists()",
        ".validate": "newData.hasChildren(['template','revision','updatedBy','savedAt']) && newData.child('updatedBy').val() === auth.uid && newData.child('revision').val() === (data.child('revision').isNumber() ? data.child('revision').val()+1 : 1)",
        "revision": {
          ".validate": "newData.isNumber()"
        },
        "updatedBy": {
          ".validate": "newData.isString() && newData.val() === auth.uid"
        },
        "savedAt": {
          ".validate": "newData.isNumber() && newData.val() <= now && newData.val() >= now - 300000"
        },
        "template": {
          ".validate": "newData.hasChildren(['version','enabled','wash','layers'])",
          "version": {
            ".validate": "newData.val() === 2"
          },
          "enabled": {
            ".validate": "newData.isBoolean()"
          },
          "background": {
            ".validate": "newData.isString() && newData.val().length <= 750000"
          },
          "wash": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 0.8"
          },
          "layers": {
            ".validate": "newData.hasChildren()",
            "$slot": {
              ".validate": "$slot.matches(/^(0|[1-9]|[12][0-9]|3[01])$/) && newData.hasChildren(['id','kind','x','y','w','h'])",
              "id": {
                ".validate": "newData.isString() && newData.val().length <= 60"
              },
              "kind": {
                ".validate": "newData.val() === 'staff' || newData.val() === 'teamLogo' || newData.val() === 'autoText' || newData.val() === 'club' || newData.val() === 'text' || newData.val() === 'image'"
              },
              "field": {
                ".validate": "newData.isString() && newData.val().length <= 30"
              },
              "slot": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3"
              },
              "label": {
                ".validate": "newData.isString() && newData.val().length <= 50"
              },
              "text": {
                ".validate": "newData.isString() && newData.val().length <= 400"
              },
              "image": {
                ".validate": "newData.isString() && newData.val().length <= 750000"
              },
              "color": {
                ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-fA-F]{6}$/)"
              },
              "visible": {
                ".validate": "newData.isBoolean()"
              },
              "font": {
                ".validate": "newData.isNumber() && newData.val() >= 8 && newData.val() <= 300"
              },
              "x": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1280"
              },
              "y": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 720"
              },
              "w": {
                ".validate": "newData.isNumber() && newData.val() >= 24 && newData.val() <= 1280"
              },
              "h": {
                ".validate": "newData.isNumber() && newData.val() >= 24 && newData.val() <= 720"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "$other": {
            ".validate": false
          }
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
